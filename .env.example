# Supabase — Postgres + Storage only. NO Supabase Auth, NO Realtime.
# Server-side only: the service role key bypasses RLS and must never reach the browser.

# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Service role key (Settings → API). Server only.
SUPABASE_SERVICE_ROLE_KEY=

# 32+ byte secret used to sign the session JWT (member_id + trip_id), used from P2
SESSION_SECRET=

# Base URL of this app, used to build invite links and QR targets
NEXT_PUBLIC_APP_URL=http://localhost:3000
